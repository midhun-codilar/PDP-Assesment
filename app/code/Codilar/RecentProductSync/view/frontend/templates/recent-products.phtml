<?php
/**
 * Recently updated products, served from codilar_search_product.
 *
 * @var \Codilar\RecentProductSync\Block\RecentProducts $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->hasItems()) {
    return;
}
?>
<section class="recent-product-sync">
    <h2 class="recent-product-sync__heading"><?= $escaper->escapeHtml($block->getHeading()) ?></h2>

    <ul class="recent-product-sync__grid">
        <?php foreach ($block->getItems() as $item): ?>
            <?php
            $name = (string)$item->getData('name');
            $url = $block->getProductUrl($item);
            $finalPrice = $block->getFormattedFinalPrice($item);
            $regularPrice = $block->getFormattedRegularPrice($item);
            $hasDiscount = $block->hasDiscount($item);
            $discount = $block->getDiscountPercent($item);
            $saving = $block->getFormattedSaving($item);
            $updatedAt = $block->getFormattedUpdatedAt($item);
            ?>
            <li class="recent-product-sync__item">
                <a class="recent-product-sync__link"
                   href="<?= $escaper->escapeUrl($url) ?>"
                   title="<?= $escaper->escapeHtmlAttr($name) ?>">
                    <span class="recent-product-sync__image-wrap">
                        <img class="recent-product-sync__image"
                             src="<?= $escaper->escapeUrl($block->getImageUrl($item)) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($name) ?>"
                             loading="lazy"
                             width="240" height="240"/>
                    </span>
                    <span class="recent-product-sync__name"><?= $escaper->escapeHtml($name) ?></span>
                </a>

                <?php if ($finalPrice !== ''): ?>
                    <span class="recent-product-sync__prices">
                        <span class="recent-product-sync__price"><?= $escaper->escapeHtml($finalPrice) ?></span>

                        <?php if ($hasDiscount && $regularPrice !== ''): ?>
                            <s class="recent-product-sync__old-price">
                                <?= $escaper->escapeHtml($regularPrice) ?>
                            </s>
                            <span class="recent-product-sync__badge">
                                <?= $escaper->escapeHtml(__('-%1% OFF', $discount)) ?>
                            </span>
                        <?php endif; ?>
                    </span>

                    <?php if ($hasDiscount && $saving !== ''): ?>
                        <span class="recent-product-sync__saving">
                            <?= $escaper->escapeHtml(__('You save %1', $saving)) ?>
                        </span>
                    <?php endif; ?>
                <?php endif; ?>

                <?php if ($updatedAt !== ''): ?>
                    <span class="recent-product-sync__updated">
                        <?= $escaper->escapeHtml(__('Updated %1', $updatedAt)) ?>
                    </span>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
</section>

