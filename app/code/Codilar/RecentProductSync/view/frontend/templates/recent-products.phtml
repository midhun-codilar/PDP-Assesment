    /* Scoped to this block and written with logical properties so the Arabic (RTL)
       store view mirrors without a second stylesheet. */
    .recent-product-sync {
        margin-block: 2.5rem;
    }

    .recent-product-sync__heading {
        margin-block-end: 1.25rem;
        text-align: start;
    }

    .recent-product-sync__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .recent-product-sync__item {
        display: flex;
        flex-direction: column;
        gap: .35rem;
        text-align: start;
    }

    .recent-product-sync__link {
        display: flex;
        flex-direction: column;
        gap: .5rem;
        text-decoration: none;
    }

    .recent-product-sync__image-wrap {
        display: block;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f5f5f5;
    }

    .recent-product-sync__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .recent-product-sync__name {
        font-weight: 600;
        line-height: 1.3;
    }

    .recent-product-sync__prices {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: .4rem;
    }

    .recent-product-sync__price {
        font-weight: 700;
    }

    .recent-product-sync__old-price {
        opacity: .55;
        font-size: .9em;
    }

    .recent-product-sync__badge {
        font-size: .78em;
        font-weight: 700;
        line-height: 1;
        padding: .25em .5em;
        border-radius: .25em;
        background: #d1403f;
        color: #fff;
        white-space: nowrap;
    }

    .recent-product-sync__saving {
        font-size: .8em;
        font-weight: 600;
        color: #1a7f45;
    }

    .recent-product-sync__updated {
        font-size: .8em;
        opacity: .65;
    }
</style>
