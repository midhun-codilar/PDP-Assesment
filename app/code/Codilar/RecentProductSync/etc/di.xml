<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Everything this module logs goes to var/log/recent_product_sync.log instead of
        system.log, so a 15-minute job cannot drown the shared log and so support can tail
        one file when the search feed looks stale.
    -->
    <virtualType name="Codilar\RecentProductSync\Logger\Handler"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/recent_product_sync.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="Codilar\RecentProductSync\Logger"
                 type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">recentProductSync</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Codilar\RecentProductSync\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Codilar\RecentProductSync\Cron\SyncProducts">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\RecentProductSync\Logger</argument>
        </arguments>
    </type>
    <type name="Codilar\RecentProductSync\Cron\PurgeExpiredRows">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\RecentProductSync\Logger</argument>
        </arguments>
    </type>
    <type name="Codilar\RecentProductSync\Observer\ProductSaveAfter">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\RecentProductSync\Logger</argument>
        </arguments>
    </type>
    <type name="Codilar\RecentProductSync\Observer\ProductDeleteAfter">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\RecentProductSync\Logger</argument>
        </arguments>
    </type>

    <!-- bin/magento codilar:search:sync -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="codilarRecentProductSync" xsi:type="object">Codilar\RecentProductSync\Console\Command\SyncProductsCommand</item>
            </argument>
        </arguments>
    </type>
</config>
