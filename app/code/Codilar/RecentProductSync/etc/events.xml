<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Global scope on purpose. Products are not only saved from the admin form: imports,
        REST calls, data patches and mass actions all run outside adminhtml, and every one
        of them has to keep the search table honest.
    -->
    <event name="catalog_product_save_after">
        <observer name="codilar_recent_product_sync_save"
                  instance="Codilar\RecentProductSync\Observer\ProductSaveAfter"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="codilar_recent_product_sync_delete"
                  instance="Codilar\RecentProductSync\Observer\ProductDeleteAfter"/>
    </event>
</config>
