<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Catalog\Block\Category\View" name="category.banner"
                   template="Magento_Catalog::category/banner.phtml" before="-">
                <arguments>
                    <argument name="banner" xsi:type="object">Codilar\Twoxl\ViewModel\CategoryBanner</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
